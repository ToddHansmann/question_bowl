{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.sipthetea.app" }],
      "destination": "https://sipthetea.app/:path*",
      "statusCode": 301
    }
  ],
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/index.html"
    }
  ]
}
