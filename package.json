{
  "name": "sip-the-tea",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "esbuild test/all.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/all.test.mjs && node node_modules/.cache/all.test.mjs",
    "test:db": "esbuild test/db.test.ts --bundle --platform=node --format=esm --packages=external --outfile=node_modules/.cache/db.test.mjs && node node_modules/.cache/db.test.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
